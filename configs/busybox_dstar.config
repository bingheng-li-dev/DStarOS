# DStarOS 的 BusyBox 裁剪配置
#
# 这是一份**相对 allnoconfig 的增量片段**，不是完整 .config。
# tools/build_busybox.sh 的流程是：allnoconfig -> 应用本文件 -> oldconfig（喂默认值）。
#
# 为什么是片段而不是 `make savedefconfig` 的产物：BusyBox 1.38 的 kconfig 比 Linux 的老，
# **既没有 savedefconfig 也没有 olddefconfig**（`make help` 里只有 allnoconfig/oldconfig/
# defconfig/menuconfig）。片段形式反而更合适——文件里每一行都是一个可读的裁剪决策，
# 而完整 .config 有 1200 多行、每次 menuconfig 都变，diff 全是噪声。
#
# 格式就是标准的 kconfig 片段：`CONFIG_X=值` 或 `# CONFIG_X is not set`。

# ---- 链接与自身路径 ----
# 本内核没有动态链接器，必须静态。顺带：-static 会压掉这套工具链默认的 -pie，
# 产出 ET_EXEC 而不是 ET_DYN——elf_load 不做重定位，static-PIE 会加载即跑飞。
CONFIG_STATIC=y
# busybox 重新 exec 自己时用的路径。默认是 "/proc/self/exe"，而**本系统没有 /proc**。
CONFIG_BUSYBOX_EXEC_PATH="/bin/busybox"
# FAT 没有符号链接，`make install` 那套 applet 链接一个也造不出来。
CONFIG_INSTALL_APPLET_DONT=y
# CONFIG_INSTALL_APPLET_SYMLINKS is not set

# ---- shell ----
CONFIG_ASH=y
# applet 分发的替代方案：ash 在 fork/exec 之前先查内置 applet 表，命中就直接跑，
# 根本不去文件系统找 /bin/ls。于是整个 rootfs 里只需要一个 /bin/busybox。
# 白赚的好处：交互式 shell 的绝大部分命令因此不走 do_exec。
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_PREFER_APPLETS=y
# 作业控制建立在 stop/cont 语义之上，而本内核没有 STOPPED 状态、没有 setsid、
# wait4 也不支持 WUNTRACED。这条是硬要求，不是偏好。
# CONFIG_ASH_JOB_CONTROL is not set
# 命令行编辑（历史/光标/Tab 补全）的 read_key 用 poll 区分孤立 ESC 与转义序列，
# 而我们没有 poll/ppoll。TTY 的规范模式已经自己处理了退格、^U、^D、^C。
# CONFIG_FEATURE_EDITING is not set

# ---- applet 最小集 ----
# cd 是 ash 内建，没有独立开关；sh 是 ash 的别名。合计 15 个 applet。
CONFIG_CAT=y
CONFIG_CP=y
CONFIG_ECHO=y
CONFIG_FALSE=y
CONFIG_LS=y
CONFIG_MKDIR=y
CONFIG_MV=y
CONFIG_PWD=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_SLEEP=y
CONFIG_TRUE=y
CONFIG_UNAME=y

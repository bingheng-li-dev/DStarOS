# DStarOS 的 BusyBox 裁剪配置：相对 allnoconfig 的增量片段，由 tools/build_busybox.sh 应用。
# BusyBox 的 kconfig 没有 savedefconfig，所以用片段而不是完整 .config。

# ---- 链接与自身路径 ----
# 没有动态链接器；-static 同时压掉工具链默认的 -pie，elf_load 不做重定位
CONFIG_STATIC=y
# 默认的 /proc/self/exe 在本系统不存在
CONFIG_BUSYBOX_EXEC_PATH="/bin/busybox"
# FAT 没有符号链接，不安装 applet 链接
CONFIG_INSTALL_APPLET_DONT=y
# CONFIG_INSTALL_APPLET_SYMLINKS is not set

# ---- shell ----
CONFIG_ASH=y
# ash 直接调用内置 applet，rootfs 里只需要一个 /bin/busybox
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_PREFER_APPLETS=y
# 内核没有 STOPPED 状态、setsid 与 WUNTRACED，必须关
# CONFIG_ASH_JOB_CONTROL is not set
# 行编辑依赖 poll，内核没有实现，必须关
# CONFIG_FEATURE_EDITING is not set

# ---- applet ----
CONFIG_CAT=y
CONFIG_CP=y
CONFIG_ECHO=y
CONFIG_FALSE=y
CONFIG_LS=y
CONFIG_MKDIR=y
CONFIG_MV=y
CONFIG_PWD=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_SLEEP=y
CONFIG_TRUE=y
CONFIG_UNAME=y
